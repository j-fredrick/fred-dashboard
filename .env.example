# Copy this file to .env and fill it in. Only PUBLIC values go here.
# Supabase -> Project Settings -> API: the Project URL and the PUBLIC key (anon / publishable).
# NEVER put the secret / service_role key in this app.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-key
# Your FRED server on Vercel
VITE_API_URL=https://fred-automation.vercel.app
# Label shown in the corner: DEMO ACCOUNT now, change to LIVE ACCOUNT when you go live
VITE_ACCOUNT_LABEL=DEMO ACCOUNT
